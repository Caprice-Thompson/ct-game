{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noImplicitAny": false,
    "sourceMap": true,
    "noEmit": true,
    "preserveConstEnums": true,
    "lib": ["dom", "ES2020"],
    "types": ["vite/client","node"]
  },
  "include": ["src"]
}
